<UserControl x:Class="Olympe.MaterialManager.Views.LeftPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             x:Name="LeftPanelRoot">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" Padding="8">
        <DockPanel>

            <!-- Section 6: Message d'erreur (bas) -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ErrorBrush}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Section 1: Titre du panneau -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding PanelTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <!-- Section 2: Selecteur de scene + bouton creation (SCENE-01, SCENE-02) -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,4">
                <ComboBox ItemsSource="{Binding Scenes}"
                          SelectedItem="{Binding ActiveScene, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          MinWidth="160" />
                <Button Content="+"
                        Command="{Binding CreerSceneCommand}"
                        AutomationProperties.Name="Créer une scène"
                        ToolTip="Créer une nouvelle scène"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
                <Button Content="-"
                        Command="{Binding SupprimerSceneCommand}"
                        AutomationProperties.Name="Supprimer la scène active"
                        ToolTip="Supprimer la scène active"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
                <Button Content="..."
                        Command="{Binding ChargerSceneExterneCommand}"
                        AutomationProperties.Name="Charger une scène externe"
                        ToolTip="Charger une scène depuis un fichier externe"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
            </StackPanel>

            <!-- B5-G : recherche de types, visible seulement si une scene est active
                 (meme visibilite que la rangee « Ajouter par clic »).
                 Watermark : pattern overlay de AddMaterialDialog (UI-M9). -->
            <Grid DockPanel.Dock="Top" Margin="0,4,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveScene}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBox x:Name="TypeSearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Rechercher un type"
                         MinHeight="32"
                         Padding="6,4,32,4" />
                <TextBlock Text="Rechercher un type…"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TypeSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Bouton d'effacement, visible quand la recherche n'est pas vide -->
                <Button Command="{Binding EffacerRechercheCommand}"
                        AutomationProperties.Name="Effacer la recherche"
                        ToolTip="Effacer la recherche"
                        HorizontalAlignment="Right"
                        Width="28" Height="28"
                        Padding="0"
                        Margin="0,2,2,2">
                    <Path Style="{StaticResource GlyphPathStyle}"
                          Data="{StaticResource CloseGeometry}"
                          Width="10" Height="10" />
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TypeSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Boutons Ajouter par clic + Retirer selection -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,4,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveScene}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- UI-m10 : le bouton reflete l'etat du mode pick (IsPickMode) -->
                <Button Command="{Binding AjouterParClicCommand}"
                        ToolTip="{Binding PickButtonTooltip}"
                        Padding="8,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Ajouter par clic dans la vue" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPickMode}" Value="True">
                                    <Setter Property="Content" Value="Sélection en cours — cliquez dans la vue" />
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="-"
                        Command="{Binding SupprimerTypeCommand}"
                        AutomationProperties.Name="Retirer le type sélectionné de la scène"
                        ToolTip="Retirer le type sélectionné de la scène"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
            </StackPanel>

            <!-- Section 5: TreeView avec groupement par categorie (D-04, D-05, D-06, SCENE-06, SCENE-07)
                 + etat « aucun resultat » de la recherche en overlay (B5-G, pattern UI-m14) -->
            <Grid>
            <TreeView ItemsSource="{Binding ActiveSceneTypes}"
                      Tag="{Binding DataContext, ElementName=LeftPanelRoot}">

                <!-- Selection via EventTrigger (Pitfall 4 - TreeView.SelectedItem non bindable) -->
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectedItemChanged">
                        <b:InvokeCommandAction Command="{Binding TreeViewSelectionChangedCommand}"
                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <!-- Touche Suppr pour supprimer (D-10) -->
                <TreeView.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding SupprimerTypeCommand}" />
                </TreeView.InputBindings>

                <!-- GroupStyle : en-tete de categorie -->
                <TreeView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontWeight="SemiBold"
                                           Padding="4,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </TreeView.GroupStyle>

                <!-- ItemTemplate : affichage FamilyName : TypeName avec support hierarchique composites (D-06) -->
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding SubTypes}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock>
                                <Run Text="{Binding FamilyName, Mode=OneWay}" />
                                <Run Text=" : " />
                                <Run Text="{Binding TypeName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="  [Composé]"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontStyle="Italic"
                                       FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsComposite}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <!-- Sous-types d'un type composite -->
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="  " />
                                    <Run Text="{Binding FamilyName, Mode=OneWay}" />
                                    <Run Text=" : " />
                                    <Run Text="{Binding TypeName, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

                <!-- Style TreeViewItem : menu contextuel + auto-depli des composites -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Supprimer"
                                              Command="{Binding PlacementTarget.Tag.SupprimerTypeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Tag" Value="{Binding DataContext, ElementName=LeftPanelRoot}" />
                    </Style>
                </TreeView.ItemContainerStyle>

            </TreeView>

            <!-- B5-G : aucun type ne matche la recherche (UI-m14) -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSearchNoResult, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Aucun type ne correspond à la recherche"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <Button Content="Effacer la recherche"
                        Command="{Binding EffacerRechercheCommand}"
                        AutomationProperties.Name="Effacer la recherche"
                        HorizontalAlignment="Center"
                        Padding="8,4" />
            </StackPanel>
            </Grid>

        </DockPanel>
    </Border>

</UserControl>
