<UserControl x:Class="Olympe.MaterialManager.Views.LeftPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             x:Name="LeftPanelRoot">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" Padding="8">
        <DockPanel>

            <!-- Section 6: Message d'erreur (bas) -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Section 1: Titre du panneau -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding PanelTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,0,0,8" />

            <!-- Section 2: Selecteur de scene + bouton creation (SCENE-01, SCENE-02) -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,4">
                <ComboBox ItemsSource="{Binding Scenes}"
                          SelectedItem="{Binding ActiveScene, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          MinWidth="160" />
                <Button Content="+"
                        Command="{Binding CreerSceneCommand}"
                        ToolTip="Creer une nouvelle scene"
                        Background="{StaticResource AccentBrush}"
                        Width="28" Height="28"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
                <Button Content="..."
                        Command="{Binding ChargerSceneExterneCommand}"
                        ToolTip="Charger une scene depuis un fichier externe"
                        Width="28" Height="28"
                        Padding="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
            </StackPanel>

            <!-- Boutons Ajouter par clic + Retirer selection -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,4,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveScene}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Content="Ajouter par clic dans la vue"
                        Command="{Binding AjouterParClicCommand}"
                        ToolTip="{Binding PickButtonTooltip}"
                        Background="{StaticResource AccentBrush}"
                        Padding="8,4" />
                <Button Content="-"
                        Command="{Binding SupprimerTypeCommand}"
                        ToolTip="Retirer le type selectionne de la scene"
                        Width="28" Height="28"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
            </StackPanel>

            <!-- Section 5: TreeView avec groupement par categorie (D-04, D-05, D-06, SCENE-06, SCENE-07) -->
            <TreeView ItemsSource="{Binding ActiveSceneTypes}"
                      Tag="{Binding DataContext, ElementName=LeftPanelRoot}">

                <!-- Selection via EventTrigger (Pitfall 4 - TreeView.SelectedItem non bindable) -->
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectedItemChanged">
                        <b:InvokeCommandAction Command="{Binding TreeViewSelectionChangedCommand}"
                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <!-- Touche Suppr pour supprimer (D-10) -->
                <TreeView.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding SupprimerTypeCommand}" />
                </TreeView.InputBindings>

                <!-- GroupStyle : en-tete de categorie -->
                <TreeView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Padding="4,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </TreeView.GroupStyle>

                <!-- ItemTemplate : affichage FamilyName : TypeName (D-06) -->
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding FamilyName, Mode=OneWay}" />
                            <Run Text=" : " />
                            <Run Text="{Binding TypeName, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </TreeView.ItemTemplate>

                <!-- Style TreeViewItem avec menu contextuel Supprimer -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Supprimer"
                                              Command="{Binding PlacementTarget.Tag.SupprimerTypeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Tag" Value="{Binding DataContext, ElementName=LeftPanelRoot}" />
                    </Style>
                </TreeView.ItemContainerStyle>

            </TreeView>

        </DockPanel>
    </Border>

</UserControl>
