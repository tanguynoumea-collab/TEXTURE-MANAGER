<UserControl x:Class="Olympe.MaterialManager.Views.LeftPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             x:Name="LeftPanelRoot">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" Padding="8">
        <DockPanel>

            <!-- Section 6: Message d'erreur (bas) -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Section 1: Titre du panneau -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding PanelTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,0,0,8" />

            <!-- Section 2: Creation de scene (D-03, SCENE-01) -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBox Text="{Binding NewSceneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="120"
                         VerticalContentAlignment="Center" />
                <Button Content="Creer"
                        Command="{Binding CreerSceneCommand}"
                        Background="{StaticResource AccentBrush}"
                        Margin="4,0,0,0" />
            </StackPanel>

            <!-- Section 3: Selecteur de scene (SCENE-02) -->
            <ComboBox DockPanel.Dock="Top"
                      ItemsSource="{Binding Scenes}"
                      SelectedItem="{Binding ActiveScene, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,4" />

            <!-- Section 4: Zone d'ajout de type (D-09, SCENE-03) -->
            <StackPanel DockPanel.Dock="Top"
                        Margin="0,4,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveScene}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Ajouter un type :"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />

                <!-- Indicateur de chargement familles -->
                <TextBlock Text="Chargement..."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontStyle="Italic"
                           Visibility="{Binding IsLoadingFamilies, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,0,2" />

                <!-- ComboBox Famille -->
                <ComboBox ItemsSource="{Binding Families}"
                          SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                          DisplayMemberPath="FamilyName"
                          Margin="0,0,0,4" />

                <!-- Indicateur de chargement types -->
                <TextBlock Text="Chargement..."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontStyle="Italic"
                           Visibility="{Binding IsLoadingTypes, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,0,2" />

                <!-- ComboBox Type -->
                <ComboBox ItemsSource="{Binding FamilyTypes}"
                          SelectedItem="{Binding SelectedFamilyType, Mode=TwoWay}"
                          DisplayMemberPath="TypeName"
                          Margin="0,0,0,4" />

                <!-- Bouton Ajouter -->
                <Button Content="Ajouter"
                        Command="{Binding AjouterTypeCommand}"
                        Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" />

                <!-- Bouton Ajouter par clic 3D (D-11, SCENE-04) -->
                <Button Content="Ajouter par clic"
                        Command="{Binding AjouterParClicCommand}"
                        ToolTip="{Binding PickButtonTooltip}"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Section 5: TreeView avec groupement par categorie (D-04, D-05, D-06, SCENE-06, SCENE-07) -->
            <TreeView ItemsSource="{Binding ActiveSceneTypes}"
                      Tag="{Binding DataContext, ElementName=LeftPanelRoot}">

                <!-- Selection via EventTrigger (Pitfall 4 - TreeView.SelectedItem non bindable) -->
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectedItemChanged">
                        <b:InvokeCommandAction Command="{Binding TreeViewSelectionChangedCommand}"
                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <!-- Touche Suppr pour supprimer (D-10) -->
                <TreeView.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding SupprimerTypeCommand}" />
                </TreeView.InputBindings>

                <!-- GroupStyle : en-tete de categorie -->
                <TreeView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Padding="4,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </TreeView.GroupStyle>

                <!-- ItemTemplate : affichage FamilyName : TypeName (D-06) -->
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding FamilyName, Mode=OneWay}" />
                            <Run Text=" : " />
                            <Run Text="{Binding TypeName, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </TreeView.ItemTemplate>

                <!-- Style TreeViewItem avec menu contextuel Supprimer -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Supprimer"
                                              Command="{Binding PlacementTarget.Tag.SupprimerTypeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Tag" Value="{Binding DataContext, ElementName=LeftPanelRoot}" />
                    </Style>
                </TreeView.ItemContainerStyle>

            </TreeView>

        </DockPanel>
    </Border>

</UserControl>
