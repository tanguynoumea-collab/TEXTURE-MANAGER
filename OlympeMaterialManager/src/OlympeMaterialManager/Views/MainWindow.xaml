<Window x:Class="Olympe.MaterialManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Olympe.MaterialManager.Views"
        Title="Olympe MaterialManager"
        Width="1400" Height="750"
        MinWidth="1000" MinHeight="500"
        Style="{DynamicResource OlympeWindowStyle}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OlympeMaterialManager;component/Themes/OlympeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Layout principal : barre d'en-tete + trois colonnes + barre Set Mat (D-07, D-14) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre d'en-tete : repertoire de projet + boutons Ouvrir / Migrer -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="Répertoire de projet :"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,8,0" />
                <!-- Cycle 4 : bascule du jeu de couleurs. Le glyphe montre la
                     DESTINATION (soleil quand on est en sombre, lune en clair) —
                     c'est l'affordance d'un interrupteur, pas d'un indicateur
                     d'etat. Path monochrome lie au Foreground : aucun emoji. -->
                <Button DockPanel.Dock="Right"
                        Command="{Binding BasculerThemeCommand}"
                        Width="32" Height="32"
                        Padding="0"
                        Margin="4,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="ToolTip" Value="Basculer en thème clair" />
                            <Setter Property="AutomationProperties.Name" Value="Basculer en thème clair" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThemeStore.CurrentTheme}" Value="Light">
                                    <Setter Property="ToolTip" Value="Basculer en thème sombre" />
                                    <Setter Property="AutomationProperties.Name" Value="Basculer en thème sombre" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Path Data="{StaticResource SunGeometry}">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource GlyphPathStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ThemeStore.CurrentTheme}" Value="Dark">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="{StaticResource MoonGeometry}">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource GlyphPathStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ThemeStore.CurrentTheme}" Value="Light">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>
                <Button DockPanel.Dock="Right"
                        Content="Migrer"
                        Command="{Binding MigrerRepertoireCommand}"
                        ToolTip="Migrer le répertoire"
                        Padding="12,4"
                        Margin="4,0,0,0" />
                <Button DockPanel.Dock="Right"
                        Content="Ouvrir"
                        Command="{Binding OuvrirRepertoireCommand}"
                        ToolTip="Ouvrir"
                        Padding="12,4"
                        Margin="4,0,0,0" />
                <TextBlock Text="{Binding ProjectDirectoryPath}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ProjectDirectoryPath}"
                           Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <!-- Trois colonnes avec GridSplitters -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="450" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Panneau gauche : Familles / Types -->
            <views:LeftPanelView Grid.Column="0"
                                 DataContext="{Binding LeftPanelVM}" />

            <!-- Separateur gauche -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <!-- Panneau central : Couches / Parametres -->
            <views:CenterPanelView Grid.Column="2"
                                   DataContext="{Binding CenterPanelVM}" />

            <!-- Separateur droit -->
            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <!-- Panneau droit : Materiaux preset -->
            <views:RightPanelView Grid.Column="4"
                                  DataContext="{Binding RightPanelVM}" />
        </Grid>

        <!-- Barre Set Mat : bouton proemirent entre les panneaux (D-14, UI-05) -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Appliquer le matériau"
                        Command="{Binding AppliquerMateriauCommand}"
                        Style="{StaticResource SetMatButtonStyle}"
                        Margin="8,0,0,0" />
                <TextBlock Text="{Binding SetMatStatusText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextBrush}"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>

</Window>
