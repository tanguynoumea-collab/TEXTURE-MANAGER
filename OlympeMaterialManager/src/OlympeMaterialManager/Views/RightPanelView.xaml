<UserControl x:Class="Olympe.MaterialManager.Views.RightPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:Olympe.MaterialManager.Converters"
             x:Name="RightPanelRoot">

    <UserControl.Resources>
        <converters:ArgbToColorConverter x:Key="ArgbToColorConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" Padding="8">
        <DockPanel>

            <!-- Section 1 : Titre du panneau -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding PanelTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <!-- Section 1b : Selecteur de preset + bouton creation + bouton dossier -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,4">
                <ComboBox ItemsSource="{Binding PresetNames}"
                          SelectedItem="{Binding ActivePresetName, Mode=TwoWay}"
                          MinWidth="160" />
                <Button Content="+"
                        Command="{Binding CreerPresetCommand}"
                        AutomationProperties.Name="Créer un preset"
                        ToolTip="Créer un nouveau preset"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
                <Button Content="-"
                        Command="{Binding SupprimerPresetCommand}"
                        AutomationProperties.Name="Supprimer le preset actif"
                        ToolTip="Supprimer le preset actif"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
                <Button Content="..."
                        Command="{Binding ChargerPresetExterneCommand}"
                        AutomationProperties.Name="Charger un preset externe"
                        ToolTip="Charger un preset depuis un fichier externe"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
            </StackPanel>

            <!-- Section 2 : Boutons Creer groupe + Ajouter materiau + Supprimer (D-10, D-11) -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,4,0,8">
                <Button Content="Créer un groupe"
                        Command="{Binding CreerGroupeCommand}" />
                <Button Content="+"
                        Command="{Binding AjouterMateriauCommand}"
                        AutomationProperties.Name="Ajouter un matériau au preset"
                        ToolTip="Ajouter un matériau au preset"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />
                <Button Content="-"
                        Command="{Binding SupprimerSelectionCommand}"
                        AutomationProperties.Name="Supprimer le groupe ou matériau sélectionné"
                        ToolTip="Supprimer le groupe ou matériau sélectionné"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="4,0,0,0" />
            </StackPanel>

            <!-- B5-D : recherche de materiaux, sous la rangee « Creer un groupe / + / − ».
                 Watermark : pattern overlay de AddMaterialDialog (UI-M9). -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="MaterialSearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Rechercher un matériau"
                         MinHeight="32"
                         Padding="6,4,32,4" />
                <TextBlock Text="Rechercher un matériau…"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=MaterialSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Bouton d'effacement, visible quand la recherche n'est pas vide -->
                <Button Content="✕"
                        Command="{Binding EffacerRechercheCommand}"
                        AutomationProperties.Name="Effacer la recherche"
                        ToolTip="Effacer la recherche"
                        HorizontalAlignment="Right"
                        Width="28" Height="28"
                        Padding="0"
                        Margin="0,2,2,2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=MaterialSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Section 4 : Message de statut -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Section 6 : Editeur de materiau (D-01, D-02, MATEDIT-01 a MATEDIT-08) -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="8"
                    Margin="0,8,0,0"
                    Visibility="{Binding MaterialEditorVM.IsVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                    <StackPanel>

                        <!-- Titre de la section + bouton Ouvrir dans Revit (B9).
                             L'edition inline est conservee (decision Q2=a) : le
                             renommage traduit l'usage dominant, pas un retrait. -->
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Content="Ouvrir dans Revit"
                                    Command="{Binding MaterialEditorVM.OuvrirDansRevitCommand}"
                                    AutomationProperties.Name="Ouvrir dans le gestionnaire de matériaux Revit"
                                    ToolTip="Ouvre le gestionnaire de matériaux Revit (le nom du matériau est copié — collez-le dans la recherche). S'ouvre lorsque Revit reprend le focus."
                                    Padding="8,4"
                                    Margin="8,0,0,0" />
                            <TextBlock Text="Visualisateur de matériau"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </DockPanel>

                        <!-- Preview couleur de surface -->
                        <Rectangle Width="60" Height="60"
                                   RadiusX="4" RadiusY="4"
                                   Margin="0,0,0,8">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{Binding MaterialEditorVM.ColorArgb, Converter={StaticResource ArgbToColorConverter}}" />
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Nom (D-02, MATEDIT-02) -->
                        <TextBlock Text="Nom :"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,2" />
                        <TextBox Text="{Binding MaterialEditorVM.MaterialName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,0,0,8">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="LostFocus">
                                    <b:InvokeCommandAction Command="{Binding MaterialEditorVM.EditNameCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </TextBox>

                        <!-- Description (D-02, MATEDIT-03) -->
                        <TextBlock Text="Description :"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,2" />
                        <TextBox Text="{Binding MaterialEditorVM.Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,0,0,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="40">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="LostFocus">
                                    <b:InvokeCommandAction Command="{Binding MaterialEditorVM.EditDescriptionCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </TextBox>

                        <!-- Motif (D-02, lecture seule) -->
                        <TextBlock Text="Motif :"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="{Binding MaterialEditorVM.PatternName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />

                        <!-- Couleur de surface (D-02, MATEDIT-04) -->
                        <TextBlock Text="Couleur de surface :"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- Petit carre couleur -->
                            <Rectangle Width="24" Height="24"
                                       RadiusX="3" RadiusY="3"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding MaterialEditorVM.ColorArgb, Converter={StaticResource ArgbToColorConverter}}" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Bouton color picker -->
                            <Button Content="..."
                                    Command="{Binding MaterialEditorVM.PickSurfaceColorCommand}"
                                    AutomationProperties.Name="Choisir la couleur de surface"
                                    Width="32" Height="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    ToolTip="Choisir la couleur de surface" />
                            <!-- Valeurs R/V/B compactes -->
                            <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,4,0" />
                            <TextBox Text="{Binding MaterialEditorVM.ColorR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Width="36" Margin="0,0,4,0">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="LostFocus">
                                        <b:InvokeCommandAction Command="{Binding MaterialEditorVM.EditColorCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                            <TextBlock Text="V" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding MaterialEditorVM.ColorG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Width="36" Margin="0,0,4,0">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="LostFocus">
                                        <b:InvokeCommandAction Command="{Binding MaterialEditorVM.EditColorCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                            <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding MaterialEditorVM.ColorB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Width="36">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="LostFocus">
                                        <b:InvokeCommandAction Command="{Binding MaterialEditorVM.EditColorCommand}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </StackPanel>

                        <!-- Teinte (D-02, D-06, MATEDIT-05, MATEDIT-08) -->
                        <StackPanel>
                            <!-- Label "Teinte non disponible" quand pas d'AppearanceAsset (D-06) -->
                            <TextBlock Text="Teinte non disponible"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MaterialEditorVM.HasAppearanceAsset}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Controles de teinte (visibles uniquement si AppearanceAsset existe) -->
                            <StackPanel Visibility="{Binding MaterialEditorVM.HasAppearanceAsset, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Activer la teinte"
                                          IsChecked="{Binding MaterialEditorVM.TintEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding MaterialEditorVM.HasAppearanceAsset}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,4" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <!-- Petit carre couleur teinte -->
                                    <Rectangle Width="24" Height="24"
                                               RadiusX="3" RadiusY="3"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding MaterialEditorVM.TintColorArgb, Converter={StaticResource ArgbToColorConverter}}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <!-- Bouton color picker teinte -->
                                    <Button Content="..."
                                            Command="{Binding MaterialEditorVM.PickTintColorCommand}"
                                            AutomationProperties.Name="Choisir la couleur de teinte"
                                            Width="32" Height="28"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding MaterialEditorVM.TintEnabled}"
                                            ToolTip="Choisir la couleur de teinte" />
                                    <!-- Valeurs R/V/B teinte compactes -->
                                    <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <TextBox Text="{Binding MaterialEditorVM.TintR, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="36" Margin="0,0,4,0"
                                             IsEnabled="{Binding MaterialEditorVM.TintEnabled}">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="LostFocus">
                                                <b:InvokeCommandAction Command="{Binding MaterialEditorVM.EditTintCommand}" />
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </TextBox>
                                    <TextBlock Text="V" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding MaterialEditorVM.TintG, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="36" Margin="0,0,4,0"
                                             IsEnabled="{Binding MaterialEditorVM.TintEnabled}">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="LostFocus">
                                                <b:InvokeCommandAction Command="{Binding MaterialEditorVM.EditTintCommand}" />
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </TextBox>
                                    <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding MaterialEditorVM.TintB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="36"
                                             IsEnabled="{Binding MaterialEditorVM.TintEnabled}">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="LostFocus">
                                                <b:InvokeCommandAction Command="{Binding MaterialEditorVM.EditTintCommand}" />
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </TextBox>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Section 5 : TreeView des presets (D-08, D-09)
                 B5-D : bindé sur DisplayedGroups (= PresetGroups hors recherche,
                 projection de clones legers pendant une recherche active)
                 + etat « aucun resultat » en overlay (UI-m14) -->
            <Grid>
            <TreeView x:Name="PresetTreeView"
                      ItemsSource="{Binding DisplayedGroups}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      BorderThickness="0"
                      Background="Transparent"
                      AllowDrop="True"
                      Tag="{Binding DataContext, ElementName=RightPanelRoot}"
                      PreviewMouseLeftButtonDown="PresetTreeView_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="PresetTreeView_PreviewMouseMove"
                      Drop="PresetTreeView_Drop"
                      DragOver="PresetTreeView_DragOver">

                <!-- Selection via EventTrigger (TreeView.SelectedItem non bindable) -->
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectedItemChanged">
                        <b:InvokeCommandAction Command="{Binding TreeViewSelectionChangedCommand}"
                                               CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <TreeView.ItemTemplate>
                    <!-- Template groupe : meme style que les categories du panneau gauche -->
                    <HierarchicalDataTemplate ItemsSource="{Binding Materials}">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Padding="4,2">
                            <Run Text="{Binding GroupName, Mode=OneWay}" />
                            <Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text="{Binding Materials.Count, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text=")" Foreground="{StaticResource TextSecondaryBrush}" />
                        </TextBlock>

                        <!-- Template enfant : meme style que les types du panneau gauche -->
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,1"
                                            Tag="{Binding DataContext, ElementName=RightPanelRoot}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Dupliquer"
                                                      Command="{Binding PlacementTarget.Tag.DupliquerMateriauCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Supprimer du preset"
                                                      Command="{Binding PlacementTarget.Tag.SupprimerMateriauCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>

                                    <!-- Pastille couleur -->
                                    <Rectangle Width="12" Height="12"
                                               RadiusX="2" RadiusY="2"
                                               Margin="0,0,6,0">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding ColorArgb, Converter={StaticResource ArgbToColorConverter}}" />
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <TextBlock Text="{Binding MaterialName}"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

                <!-- Style TreeViewItem (D-09) : groupes ouverts par defaut -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="True" />
                    </Style>
                </TreeView.ItemContainerStyle>

            </TreeView>

            <!-- B5-D : aucun materiau ne matche la recherche (UI-m14) -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSearchNoResult, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Aucun matériau ne correspond à la recherche"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <Button Content="Effacer la recherche"
                        Command="{Binding EffacerRechercheCommand}"
                        AutomationProperties.Name="Effacer la recherche"
                        HorizontalAlignment="Center"
                        Padding="8,4" />
            </StackPanel>
            </Grid>

        </DockPanel>
    </Border>

</UserControl>
