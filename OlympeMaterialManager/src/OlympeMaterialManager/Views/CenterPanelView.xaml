<UserControl x:Class="Olympe.MaterialManager.Views.CenterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:Olympe.MaterialManager.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" Padding="8">
        <DockPanel>

            <!-- Section 1 : Titre du panneau -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding PanelTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,0,0,8" />

            <!-- Section 2 : Nom du type selectionne -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding SelectedTypeName}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="Medium"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTypeName}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Section 3 : Label de mode (Couches / Parametres materiaux) -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding ModeLabel}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModeLabel}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Section 4 : Placeholder (aucun type selectionne) -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Selectionnez un type pour voir ses couches"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}" />

            <!-- Section 5 : Indicateur de chargement -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Chargement..."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Section 6 : Affichage erreur -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Section 7 : ListBox des couches CompoundStructure (D-12, D-17, LAYER-01, LAYER-02, LAYER-04, LAYER-05) -->
            <ListBox ItemsSource="{Binding Layers}"
                     SelectionMode="Extended"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderThickness="0"
                     Visibility="{Binding ShowLayers, Converter={StaticResource BoolToVis}}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction Command="{Binding SelectionChangedCommand}"
                                               CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="{Binding Function}"
                                       Foreground="{StaticResource AccentBrush}"
                                       MinWidth="120" />
                            <TextBlock Text=" -- " Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="{Binding Width, StringFormat={}{0:F1}}" />
                                <Run Text=" mm" />
                            </TextBlock>
                            <TextBlock Text=" -- " Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding MaterialName}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Section 8 : ListBox des parametres materiaux (D-15, D-17, LAYER-03, LAYER-04, LAYER-05) -->
            <ListBox ItemsSource="{Binding MaterialParams}"
                     SelectionMode="Extended"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderThickness="0"
                     Visibility="{Binding ShowParameters, Converter={StaticResource BoolToVis}}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction Command="{Binding SelectionChangedCommand}"
                                               CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="{Binding ParameterName}"
                                       Foreground="{StaticResource AccentBrush}"
                                       MinWidth="150" />
                            <TextBlock Text=" -- " Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CurrentMaterialName}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

        </DockPanel>
    </Border>

</UserControl>
