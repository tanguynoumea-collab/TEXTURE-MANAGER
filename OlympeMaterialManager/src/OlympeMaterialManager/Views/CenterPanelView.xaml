<UserControl x:Class="Olympe.MaterialManager.Views.CenterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource BackgroundBrush}" Padding="8">
        <StackPanel>
            <!-- Titre du panneau -->
            <TextBlock Text="{Binding PanelTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,0,0,8" />

            <!-- Placeholder -->
            <TextBlock Text="Selectionnez un type pour voir ses couches"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </Border>

</UserControl>
