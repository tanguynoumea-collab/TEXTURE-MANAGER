<UserControl x:Class="Olympe.MaterialManager.Views.CenterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:Olympe.MaterialManager.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- B8 : brush du liseré matériau (couleur / texture tuilée selon le mode) -->
        <converters:MaterialPreviewBrushConverter x:Key="MaterialPreviewBrush" />

        <!-- UI-M6 : style de carte partage par les deux ListBox (couches et parametres),
             couleurs via les tokens CardBrush / CardHoverBrush / CardSelectedBrush du theme.
             B8 (DR1-1) : liseré matériau de 6 px sur toute la hauteur, DES DEUX CÔTÉS
             de la carte (bande identique à gauche et à droite : même brush, coins
             arrondis épousant chaque côté), À L'INTÉRIEUR de la bordure de
             sélection accent (accent = état périphérique, liseré = donnée). Le mode
             d'aperçu se propage par binding sur PreviewModeStore.CurrentMode (INPC,
             alimenté par PreviewModeChangedMessage côté store) — documenté : choix
             « propriété exposée par le VM » plutôt qu'un abonnement message dans la
             vue. ColorArgb null (« Par catégorie ») → liseré transparent ; texture
             introuvable → couleur (fallback silencieux sur 6 px, spec 2.6). -->
        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OlympeFocusVisualStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="6"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        CornerRadius="4,0,0,4"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource MaterialPreviewBrush}"
                                                      ConverterParameter="Tile">
                                            <Binding Path="DataContext.PreviewModeStore.CurrentMode"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="ColorArgb" />
                                            <Binding Path="TexturePath" />
                                        </MultiBinding>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="12,10" />
                                <!-- DR1-1 : bande droite, miroir exact de la gauche
                                     (même brush couleur/texture, mêmes fallbacks). -->
                                <Border Grid.Column="2"
                                        CornerRadius="0,4,4,0"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource MaterialPreviewBrush}"
                                                      ConverterParameter="Tile">
                                            <Binding Path="DataContext.PreviewModeStore.CurrentMode"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="ColorArgb" />
                                            <Binding Path="TexturePath" />
                                        </MultiBinding>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" Padding="8">
        <DockPanel>

            <!-- Section 1 : Titre du panneau -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding PanelTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <!-- Section 2 : Nom du type selectionne -->
            <!-- UI-03: BasedOn added for theme consistency -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding SelectedTypeName}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="Medium"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTypeName}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Section 3 : Label de mode (Couches / Parametres materiaux) -->
            <!-- UI-03: BasedOn added for theme consistency -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding ModeLabel}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModeLabel}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Section 4 : Placeholder (aucun type selectionne) -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Sélectionnez un type pour voir ses couches"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}" />

            <!-- Section 4b : Message type compose -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Type composé — sélectionnez un sous-type pour éditer ses couches"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding ShowCompositeMessage, Converter={StaticResource BoolToVis}}" />

            <!-- Section 5 : Indicateur de chargement -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Chargement..."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Section 6 : Affichage erreur -->
            <!-- UI-03: BasedOn added for theme consistency -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Grid conteneur pour les deux ListBox : remplit l'espace restant du DockPanel -->
            <Grid>

            <!-- Section 7 : ListBox des couches CompoundStructure -->
            <ListBox ItemsSource="{Binding Layers}"
                     SelectionMode="Extended"
                     Background="{StaticResource BackgroundBrush}"
                     BorderThickness="0"
                     Visibility="{Binding ShowLayers, Converter={StaticResource BoolToVis}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction Command="{Binding SelectionChangedCommand}"
                                               CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardItemStyle}" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0"
                                       Text="{Binding Function}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <TextBlock Grid.Column="1" Grid.Row="0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       FontSize="13">
                                <Run Text="{Binding Width, StringFormat={}{0:F1}}" />
                                <Run Text=" mm" />
                            </TextBlock>
                            <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding MaterialName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Section 8 : Parametres materiaux (familles sans couches) -->
            <ListBox ItemsSource="{Binding MaterialParams}"
                     SelectionMode="Extended"
                     Background="{StaticResource BackgroundBrush}"
                     BorderThickness="0"
                     Visibility="{Binding ShowParameters, Converter={StaticResource BoolToVis}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction Command="{Binding SelectionChangedCommand}"
                                               CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardItemStyle}" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{Binding ParameterName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding CurrentMaterialName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            </Grid>
        </DockPanel>
    </Border>

</UserControl>
