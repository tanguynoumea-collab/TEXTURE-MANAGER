<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>OlympeMaterialManager.Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>StagingDir=staging</DefineConstants>
    <!-- ICE64: Autodesk/Revit/Addins are shared directories we must NOT remove on uninstall -->
    <!-- ICE91: Per-user .addin files in per-machine install is the standard Revit addin pattern -->
    <SuppressIces>ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
