<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>OlympeMaterialManager.Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- PKG-03 : Version vient de Directory.Build.props via $(Version) -->
    <DefineConstants>StagingDir=staging;Version=$(Version)</DefineConstants>
    <!-- PKG-05 : plus de SuppressIces — les .addin sont en CommonAppDataFolder
         (perMachine coherent), ICE64/ICE91 ne s'appliquent plus -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
